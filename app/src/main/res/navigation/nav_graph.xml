<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.field.survey.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_feed"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.field.survey.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_register_to_feed"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.field.survey.ui.feed.FeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_feed_to_detail"
            app:destination="@id/detailFragment" />

        <action
            android:id="@+id/action_feed_to_myPoints"
            app:destination="@id/myPointsFragment" />

        <action
            android:id="@+id/action_feed_to_map"
            app:destination="@id/mapFragment" />

        <action
            android:id="@+id/action_feed_to_profile"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_feed_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.field.survey.ui.detail.DetailFragment"
        android:label="Details"
        tools:layout="@layout/fragment_detail">

        <argument
            android:name="pointId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/editPointFragment"
        android:name="com.field.survey.ui.editpoint.EditPointFragment"
        android:label="Edit Point"
        tools:layout="@layout/fragment_edit_point">

        <argument
            android:name="pointId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myPointsFragment"
        android:name="com.field.survey.ui.mypoints.MyPointsFragment"
        android:label="My Points"
        tools:layout="@layout/fragment_my_points">

        <action
            android:id="@+id/action_myPoints_to_edit"
            app:destination="@id/editPointFragment" />

        <action
            android:id="@+id/action_myPoints_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.field.survey.ui.map.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map">

        <action
            android:id="@+id/action_map_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.field.survey.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.field.survey.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
