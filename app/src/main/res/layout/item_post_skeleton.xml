<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/bg_top"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <View
            android:id="@+id/skelPhoto"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skelTitle"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skelPhoto"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skelChip"
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toEndOf="@id/skelPhoto"
            app:layout_constraintTop_toBottomOf="@id/skelTitle" />

        <View
            android:id="@+id/skelNotes"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skelPhoto"
            app:layout_constraintTop_toBottomOf="@id/skelChip" />

        <View
            android:id="@+id/skelAuthor"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toEndOf="@id/skelPhoto"
            app:layout_constraintTop_toBottomOf="@id/skelNotes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
